# Target Database Connection
ARGUS_DATABASE_DSN=postgresql://argus:argus@localhost:5432/main

# Sandbox Settings
ARGUS_SANDBOX_IMAGE=postgres:16-alpine

# Brain Settings (Gemini)
ARGUS_BRAIN_PROVIDER=gemini
ARGUS_BRAIN_GEMINI_API_KEY=your_gemini_api_key_here
ARGUS_BRAIN_GEMINI_MODEL=gemini-3.5-flash
